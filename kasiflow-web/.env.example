# Supabase project URL (Project settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon / publishable key ONLY. Never put the service_role key in a frontend.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Base URL of the KasiFlow SA ASP.NET Core API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5080
# Customers sign in with a one-time code (no password). Email codes work out of the box.
# IMPORTANT: in Supabase -> Authentication -> Email Templates -> "Magic Link", include {{ .Token }} in the template
# so the email shows the 6-digit code (the link in the same email also works).
# Set to true only after an SMS provider is configured in Supabase (Authentication -> Providers -> Phone).
VITE_CUSTOMER_SMS_OTP=false

# Local demos only: show "Demo account? Sign in with a password" on the customer sign-in (for accounts made by `dotnet run -- demo-users`).
VITE_DEMO_PASSWORD_SIGNIN=false
