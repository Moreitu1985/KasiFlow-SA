<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure domain library: financial calculations, Growth Engine rules and catalogues.
       Deliberately has NO NuGet dependencies so it can be built and tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>KasiFlow.Core</RootNamespace>
  </PropertyGroup>
</Project>
